# Database
DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5432/bakim_db
TEST_DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5433/bakim_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT (64 hex characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# ENCRYPTION (64 hex characters — VERY CRITICAL)
MASTER_ENCRYPTION_KEY=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bakim-documents
MINIO_USE_SSL=false

# Application
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Demo request notification (optional — if empty, no email is sent, only logged)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=arslannizzet10@gmail.com

# AI — Shift handover summary (disabled by default)
# Processes patient health data. A local model (ollama) is recommended in production;
# before choosing "claude", obtain the required data-protection / cross-border transfer consent.
LLM_ENABLED=false
# claude | ollama
LLM_PROVIDER=ollama
# Kept only in the apps/api environment, never exposed to the frontend via NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Ollama has no authentication; it must only be reachable from the internal network
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Daily summary limit per user (per-minute limit: 5)
AI_SUMMARY_DAILY_LIMIT=50
