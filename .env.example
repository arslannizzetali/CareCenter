# Veritabanı
DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5432/bakim_db
TEST_DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5433/bakim_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT (64 karakter hex)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# ŞİFRELEME (64 karakter hex — ÇOK KRİTİK)
MASTER_ENCRYPTION_KEY=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bakim-documents
MINIO_USE_SSL=false

# Uygulama
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Demo talep bildirimi (opsiyonel — boşsa e-posta gönderilmez, sadece loglanır)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=arslannizzet10@gmail.com
