# Database
DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5432/bakim_db
TEST_DATABASE_URL=postgresql://bakim_user:bakim_pass@localhost:5433/bakim_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT (64 hex characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# ENCRYPTION (64 hex characters — VERY CRITICAL)
MASTER_ENCRYPTION_KEY=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bakim-documents
MINIO_USE_SSL=false

# Application
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Demo request notification (optional — if empty, no email is sent, only logged)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=arslannizzet10@gmail.com

# Yapay zekâ — Vardiya devir özeti (varsayılan KAPALI)
# Engelli sağlık verisi işlenir. Production'da yerel model (ollama) önerilir;
# "claude" seçmeden önce KVKK / yurt dışı aktarım onayı alınmalıdır.
LLM_ENABLED=false
# claude | ollama | amd
LLM_PROVIDER=ollama
# Sadece apps/api ortamında tutulur, asla NEXT_PUBLIC_ ile frontend'e verilmez
ANTHROPIC_API_KEY=
# Ollama'nın kimlik doğrulaması yoktur; yalnızca iç ağdan erişilebilir olmalıdır
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# AMD (LLM_PROVIDER=amd): OpenAI-compatible endpoint; the model runs on AMD GPUs.
# AMD Token Factory: https://developer.amd.com.cn/radeon/api/v1 (or your own vLLM server: http://<host>:8000/v1)
# Only the anonymized prompt is sent; use seed/demo data only.
AMD_LLM_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_LLM_API_KEY=
AMD_LLM_MODEL=DeepSeek-V4-Flash
# Kullanıcı başına günlük özet sınırı (dakikalık sınır: 5)
AI_SUMMARY_DAILY_LIMIT=50
